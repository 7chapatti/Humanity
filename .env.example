# Copy to .env.local for local work; set the same names in Vercel for production.
# Never commit real values.

# Which API writes the posts: anthropic or openai. Only that provider's key is required.
AI_PROVIDER=anthropic

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI API key (platform.openai.com). Use a separate OpenAI project for this app
# if you opt it in to data sharing for complimentary tokens.
OPENAI_API_KEY=

# Optional model override. Defaults: claude-sonnet-5-5 / gpt-5.4-mini-2026-03-17
POST_MODEL=

# Comma-separated https RSS/Atom feeds
FEED_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.theguardian.com/world/rss

# Drafts per run (1-30)
POSTS_PER_RUN=14

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public base URL of the deployed site, no trailing slash
SITE_URL=http://localhost:3000

# The only email allowed into /admin
ADMIN_EMAIL=

# Random string, 32+ characters: openssl rand -hex 32
CRON_SECRET=
